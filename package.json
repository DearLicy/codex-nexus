{
  "name": "codex-nexus",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first provider, account-pool and artifact workspace for Codex",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cargo run --manifest-path native/Cargo.toml",
    "build": "cargo build --release --manifest-path native/Cargo.toml",
    "build:desktop": "cargo build --release --manifest-path native/Cargo.toml",
    "package:macos": "bash scripts/package-macos.sh",
    "package:windows": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml && node --test tests/**/*.test.mjs",
    "gateway": "node packages/gateway/server.mjs",
    "image-mcp": "node packages/image-mcp/server.mjs"
  }
}
