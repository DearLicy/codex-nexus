{
  "name": "codex-nexus",
  "version": "0.1.0",
  "private": false,
  "description": "A local-first provider, account-pool and artifact workspace for Codex",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "dev:desktop": "tauri dev",
    "build": "tsc --noEmit && vite build",
    "build:desktop": "tauri build",
    "tauri": "tauri",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.mjs",
    "gateway": "node packages/gateway/server.mjs",
    "image-mcp": "node packages/image-mcp/server.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "latest"
  }
}
